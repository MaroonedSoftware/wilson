{
    "name": "@wilson/cli",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "main": "src/index.ts",
    "bin": {
        "wilson": "./src/index.ts"
    },
    "scripts": {
        "build": "tsc --noEmit",
        "wilson": "node --no-warnings --import @swc-node/register/esm-register ./src/index.ts",
        "lint": "eslint --fix",
        "lint:check": "eslint",
        "test": "vitest run"
    },
    "dependencies": {
        "@clack/prompts": "^1.8.1",
        "@maroonedsoftware/johnny5": "^8.1.10",
        "@napi-rs/keyring": "^1.3.0",
        "@swc-node/register": "^1.12.1",
        "@wilson/sdk": "workspace:*",
        "injectkit": "^1.7.1",
        "luxon": "^3.7.2",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@types/luxon": "^3.7.2",
        "@types/pg": "^8.20.0"
    }
}
