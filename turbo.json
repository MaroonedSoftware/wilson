{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"],
            "env": ["VISUAL", "EDITOR"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"],
            "env": ["TEST_DATABASE_HOST", "TEST_DATABASE_PORT", "TEST_DATABASE_USER", "TEST_DATABASE_PASSWORD", "TEST_DATABASE_NAME"]
        },
        "build:datatypes": {
            "dependsOn": ["migrate:up"],
            "cache": false
        },
        "codegen": {
            "cache": false
        },
        "migrate:up": {
            "cache": false
        },
        "migrate:down": {
            "cache": false
        },
        "migrate:down:all": {
            "cache": false
        },
        "migrate:create": {
            "cache": false
        }
    }
}
