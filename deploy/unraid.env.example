# Wilson on Unraid: copy to /mnt/cache/appdata/wilson/wilson.env, fill in, and keep it readable by
# root only. It is both compose's --env-file (the ${...} in docker-compose.unraid.yml) and the API
# container's env_file, so everything apps/api/.env.example describes can be set here too.

# --- The stack ---

# Where this stack keeps everything: Postgres, backups, worktrees, secrets, the Claude login.
WILSON_APPDATA=/mnt/cache/appdata/wilson
WILSON_ENV_FILE=/mnt/cache/appdata/wilson/wilson.env
# The folder holding the clones of every project Wilson manages, each in a folder named after it.
WILSON_PROJECTS=/mnt/cache/projects
# Unraid's nobody:users. Make WILSON_PROJECTS writable by them; the stack sets up WILSON_APPDATA itself.
PUID=99
PGID=100
TZ=America/New_York
POSTGRES_PASSWORD=

# --- How the board is reached ---

WILSON_API_PORT=13100
WILSON_WEB_PORT=13101
# The API as the browser reaches it, baked into the web build.
WILSON_API_URL=http://tower:13100
# The web app's origin, which the API allows to call it with credentials. Must match exactly.
WEB_ORIGINS=http://tower:13101

# --- The first project ---

# A clone of it must be at $WILSON_PROJECTS/$PROJECT_NAME.
PROJECT_NAME=wilson

# --- The engine on this server ---

# Planning sessions, and any stage left `placement: local`, start the engine here. It signs in with
# this token (from `claude setup-token`), or, with the line left commented out, with a login kept
# under $WILSON_APPDATA/claude (`docker exec -it wilson-unraid-api claude`, then /login). Never set it
# empty: an empty token is still a token, and the engine would not fall back to the login.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Git ---

# Who the runner's commits and merges are by.
GIT_AUTHOR_NAME=Wilson
GIT_AUTHOR_EMAIL=wilson@localhost
GIT_COMMITTER_NAME=Wilson
GIT_COMMITTER_EMAIL=wilson@localhost

# --- Optional, as in apps/api/.env.example ---

POLLER_ENABLED=false
NOTIFY_WEBHOOK_URL=
NOTIFY_BASE_URL=http://tower:13101
GITHUB_TOKEN=
GITHUB_REPO=
