# Build outputs
dist/
build/

# Turbo
.turbo

# Testing
coverage
.coverage
# Written by the testing stage's test command and read by its verifier. A generated
# artifact: commit-on-pass does `git add -A`, so without this it lands on the branch.
.vitest-report.json

# Env
.env
.env.local
worker.env
*.log
logs/

# Runner working state — worktrees and materialized plans never belong in git
.worktrees/
.run/

# Terraform's local working folder
.terraform/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude
.claude/*
!.claude/settings.json
CLAUDE.local.md

# dbmate schema dump (migrations are the source of truth)
apps/api/db/schema.sql

# ContractKit's incremental compile cache. Regenerated on every codegen run.
.contractkit/
