{
    "name": "@wilson/api",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "exports": {
        "./cli-bootstrap": "./src/cli-bootstrap.ts"
    },
    "scripts": {
        "build": "tsc",
        "build:datatypes": "pnpm sync:enum-overrides && kysely-codegen",
        "sync:enum-overrides": "node --no-warnings --import @swc-node/register/esm-register scripts/sync.enum.overrides.ts",
        "codegen": "contractkit",
        "dev": "node --watch --import @swc-node/register/esm-register ./src/index.ts",
        "start": "node --import @swc-node/register/esm-register ./src/index.ts",
        "migrate:up": "dbmate -d ./data/migrations --no-dump-schema up",
        "migrate:down": "dbmate -d ./data/migrations --no-dump-schema down",
        "migrate:down:all": "./scripts/rollbackall.sh",
        "migrate:create": "dbmate -d ./data/migrations new",
        "lint": "eslint --fix",
        "lint:check": "eslint",
        "typecheck": "tsc -p tsconfig.tests.json",
        "test": "vitest run",
        "test:engine": "vitest run --config vitest.engine.config.ts"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.41",
        "@ai-sdk/openai": "^4.0.46",
        "@ai-sdk/xai": "^4.0.43",
        "@anthropic-ai/claude-agent-sdk": "0.3.241",
        "@maroonedsoftware/appconfig": "^2.6.1",
        "@maroonedsoftware/authentication": "^6.7.0",
        "@maroonedsoftware/cache": "^0.6.0",
        "@maroonedsoftware/encryption": "^0.5.13",
        "@maroonedsoftware/errors": "^1.9.1",
        "@maroonedsoftware/jobbroker": "^1.12.2",
        "@maroonedsoftware/koa": "^4.1.3",
        "@maroonedsoftware/kysely": "^0.7.11",
        "@maroonedsoftware/logger": "^1.1.9",
        "@maroonedsoftware/mcp": "^0.7.7",
        "@maroonedsoftware/policies": "^0.6.9",
        "@maroonedsoftware/serverfeed": "^0.1.6",
        "@maroonedsoftware/utilities": "^1.11.5",
        "@maroonedsoftware/zod": "^0.8.0",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@wilson/worker-protocol": "workspace:*",
        "ai": "^7.0.77",
        "injectkit": "^1.7.1",
        "kysely": "^0.29.5",
        "luxon": "^3.7.2",
        "pg": "^8.23.0",
        "pg-boss": "^12.27.0",
        "picomatch": "^4.0.5",
        "rate-limiter-flexible": "^11.2.0",
        "reflect-metadata": "^0.2.2",
        "ws": "^8.21.3",
        "yaml": "^2.9.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@contractkit/cli": "^0.11.10",
        "@contractkit/plugin-csharp": "^0.4.0",
        "@contractkit/plugin-kotlin": "^0.3.0",
        "@contractkit/plugin-typescript": "^0.42.0",
        "@maroonedsoftware/johnny5": "^8.1.10",
        "@napi-rs/keyring": "^1.3.0",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@types/koa": "^3.0.3",
        "@types/luxon": "^3.7.2",
        "@types/pg": "^8.20.0",
        "@types/picomatch": "^4.0.2",
        "@types/ws": "^8.18.2",
        "@wilson/worker": "workspace:*",
        "dbmate": "^2.33.0",
        "kysely-codegen": "^0.20.0"
    }
}
