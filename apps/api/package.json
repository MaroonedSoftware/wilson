{
    "name": "@wilson/api",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "exports": {
        "./cli-bootstrap": "./src/cli-bootstrap.ts"
    },
    "scripts": {
        "build": "tsc",
        "build:datatypes": "kysely-codegen",
        "codegen": "contractkit",
        "dev": "node --watch --import @swc-node/register/esm-register ./src/index.ts",
        "start": "node --import @swc-node/register/esm-register ./src/index.ts",
        "migrate:up": "dbmate -d ./data/migrations --no-dump-schema up",
        "migrate:down": "dbmate -d ./data/migrations --no-dump-schema down",
        "migrate:down:all": "./scripts/rollbackall.sh",
        "migrate:create": "dbmate -d ./data/migrations new",
        "lint": "eslint --fix",
        "test": "vitest run"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.41",
        "@ai-sdk/openai": "^4.0.46",
        "@ai-sdk/xai": "^4.0.43",
        "@anthropic-ai/claude-agent-sdk": "0.3.241",
        "@maroonedsoftware/appconfig": "^2.5.1",
        "@maroonedsoftware/cache": "^0.4.5",
        "@maroonedsoftware/errors": "^1.9.0",
        "@maroonedsoftware/jobbroker": "^1.12.0",
        "@maroonedsoftware/koa": "^3.0.10",
        "@maroonedsoftware/kysely": "^0.7.9",
        "@maroonedsoftware/logger": "^1.1.8",
        "@maroonedsoftware/serverfeed": "^0.1.5",
        "@maroonedsoftware/utilities": "^1.11.5",
        "@maroonedsoftware/zod": "^0.5.6",
        "ai": "^7.0.77",
        "injectkit": "^1.7.0",
        "kysely": "^0.29.5",
        "luxon": "^3.7.2",
        "pg": "^8.23.0",
        "pg-boss": "^12.27.0",
        "picomatch": "^4.0.5",
        "reflect-metadata": "^0.2.2",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@contractkit/cli": "^0.10.7",
        "@contractkit/plugin-typescript": "^0.31.2",
        "@maroonedsoftware/johnny5": "^8.0.10",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@types/koa": "^3.0.3",
        "@types/luxon": "^3.7.2",
        "@types/pg": "^8.20.0",
        "@types/picomatch": "^4.0.2",
        "dbmate": "^2.33.0",
        "kysely-codegen": "^0.20.0"
    }
}
