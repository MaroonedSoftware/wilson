diff --git a/apps/api/src/modules/feed/card.feed.listener.ts b/apps/api/src/modules/feed/card.feed.listener.ts
new file mode 100644
index 00000000..7316a69d
--- /dev/null
+++ b/apps/api/src/modules/feed/card.feed.listener.ts
@@ -0,0 +1,49 @@
+import type { PoolClient } from 'pg';
+import type { KyselyPool } from '@maroonedsoftware/kysely';
+import type { Logger } from '@maroonedsoftware/logger';
+import { CARD_FEED_CHANNEL, cardFeed } from './card.feed.js';
+
+/** The shape `EventLog.append` notifies with — see its `pg_notify` call. */
+interface CardFeedNotification {
+    project: string;
+    cardId: string;
+    stage: string | null;
+    type: string;
+    payload: Record<string, unknown>;
+}
+
+/**
+ * Bridges Postgres `NOTIFY` on {@link CARD_FEED_CHANNEL} into the in-process {@link cardFeed} bus.
+ *
+ * `EventLog.append` runs in every process that touches a card — this API server's own job runner,
+ * and a separate `wilson` CLI invocation moving a card by hand — but `ServerFeed` is an in-process
+ * bus (its own docs: not for "cross-process fan-out"). Postgres is the one thing every process
+ * already shares, so `LISTEN`/`NOTIFY` is the bridge: whichever process appends an event notifies
+ * this channel, and this server, listening on it, republishes onto `cardFeed` for its SSE
+ * subscribers.
+ *
+ * Holds one connection checked out of `pool` for as long as `signal` stays unaborted. That
+ * connection must never be returned to the pool afterwards — a later query borrowing it would run
+ * against a connection still subscribed to `card_events` — so teardown discards it
+ * (`client.release(true)`) instead of releasing it for reuse.
+ */
+export const startCardFeedListener = async (pool: KyselyPool, logger: Logger, signal: AbortSignal): Promise<void> => {
+    const client: PoolClient = await pool.connect();
+
+    client.on('notification', message => {
+        if (message.channel !== CARD_FEED_CHANNEL || !message.payload) {
+            return;
+        }
+        try {
+            const event = JSON.parse(message.payload) as CardFeedNotification;
+            cardFeed.status(event.project, event.cardId, event.type, { stage: event.stage, payload: event.payload });
+        } catch (err) {
+            logger.error(err);
+        }
+    });
+    client.on('error', err => logger.error(err));
+
+    await client.query(`LISTEN ${CARD_FEED_CHANNEL}`);
+
+    signal.addEventListener('abort', () => client.release(true), { once: true });
+};
diff --git a/apps/api/src/modules/feed/card.feed.route.ts b/apps/api/src/modules/feed/card.feed.route.ts
new file mode 100644
index 00000000..1eac2be9
--- /dev/null
+++ b/apps/api/src/modules/feed/card.feed.route.ts
@@ -0,0 +1,26 @@
+import { openSseStream, type SseContext } from '@maroonedsoftware/koa';
+import type { ServerFeed } from '@maroonedsoftware/serverfeed';
+
+/**
+ * Serve one `/api/feed` subscriber: the latest known state of every card (`feed.snapshot()`) up
+ * front, then every event as it is published.
+ *
+ * Deliberately not `@maroonedsoftware/koa/serverfeed`'s `handleServerFeed`: that helper replays
+ * the buffered ring since the client's `Last-Event-ID`, which for a fresh connection — the only
+ * case this route needs, since reconnection and `Last-Event-ID` resume are out of scope — means
+ * replaying everything still buffered. That is exactly the "replay it has to fold" this feed
+ * exists to avoid; a board wants current state, not history. `feed.snapshot()` gives the latest
+ * event per card instead, so a subscriber is caught up in one shot with nothing to fold.
+ *
+ * `openSseStream` is the same transport primitive `handleServerFeed` is built on, so this is still
+ * the library's mechanism, just composed for latest-per-key rather than replay.
+ */
+export const openCardFeedStream = (ctx: SseContext, feed: ServerFeed): void => {
+    const stream = openSseStream(ctx);
+
+    for (const event of feed.snapshot()) {
+        stream.event({ event: 'card', data: event });
+    }
+
+    stream.onClose(feed.onEvent({}, event => stream.event({ event: 'card', data: event })));
+};
diff --git a/apps/api/src/modules/feed/card.feed.ts b/apps/api/src/modules/feed/card.feed.ts
new file mode 100644
index 00000000..84bb39b0
--- /dev/null
+++ b/apps/api/src/modules/feed/card.feed.ts
@@ -0,0 +1,20 @@
+import { ServerFeed } from '@maroonedsoftware/serverfeed';
+
+/**
+ * The Postgres `NOTIFY`/`LISTEN` channel the card feed rides. See `card.feed.listener.ts` for the
+ * subscriber and `event.log.ts` for the publisher.
+ */
+export const CARD_FEED_CHANNEL = 'card_events';
+
+/**
+ * The card feed: current stage and most recent event, keyed by card
+ * (`ServerFeed`'s `${source}:${correlationId}` snapshot key, with `source` the project and
+ * `correlationId` the card id).
+ *
+ * A plain module-level singleton rather than a DI registration. `data.module.ts` and
+ * `events.module.ts` — where this app's other cross-cutting singletons (the Kysely pool,
+ * `EventLog`) are wired into the container — are outside this card's files in scope. That is no
+ * loss: `ServerFeed` has no `@Injectable()` decorator (its own docs say to register it as a value,
+ * not a class), so a plain singleton is exactly how it is meant to be held.
+ */
+export const cardFeed = new ServerFeed();
