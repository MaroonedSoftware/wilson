index 00000000..2b061345
--- /dev/null
+++ b/apps/api/src/modules/jobs/card.stage.job.ts
@@ -0,0 +1,61 @@
+import { Injectable } from 'injectkit';
+import { Job, JobBroker } from '@maroonedsoftware/jobbroker';
+import { BoardConfig } from '#modules/board/board.config.js';
+import { EventLog } from '#modules/events/event.log.js';
+import { loadStages } from '#modules/stages/stage.config.js';
+import { StageDispatcher } from '#modules/stages/stage.dispatcher.js';
+import { decideChain } from './chain.decision.js';
+
+export interface CardStagePayload {
+    cardId: string;
+    stageName: string;
+}
+
+/**
+ * Runs one stage for one card, then decides whether the chain keeps going.
+ *
+ * `StageDispatcher.run` only ever reports where a card landed (`transitionedTo`), forward on a pass
+ * or backward on a kickback, and leaves it unset for a `manual` stage it deliberately does not
+ * touch. Turning "landed here" into "keep going" or "stop" is this job's decision, kept out of the
+ * dispatcher so it stays queue-agnostic — `wilson card run` calls the same dispatcher without ever
+ * enqueuing anything.
+ */
+@Injectable()
+export class CardStageJob extends Job<CardStagePayload> {
+    constructor(
+        private readonly dispatcher: StageDispatcher,
+        private readonly broker: JobBroker,
+        private readonly board: BoardConfig,
+        private readonly events: EventLog,
+    ) {
+        super();
+    }
+
+    async run({ cardId, stageName }: CardStagePayload): Promise<void> {
+        const outcome = await this.dispatcher.run(cardId, stageName);
+
+        // Unset means the stage just run was a `manual` gate the dispatcher left alone — nothing
+        // for the chain to do until a human moves the card.
+        if (!outcome.transitionedTo) {
+            return;
+        }
+
+        const stages = await loadStages(this.board.boardRoot);
+        const decision = decideChain(outcome.transitionedTo, stages);
+
+        if (decision.continue) {
+            await this.broker.send('card.stage', { cardId, stageName: outcome.transitionedTo });
+            return;
+        }
+
+        // Recorded rather than silently dropped: an operator watching the card's history needs to
+        // know the chain stopped here, and why, without having to reconstruct it from stage config.
+        await this.events.append({
+            project: this.board.project,
+            cardId,
+            stage: stageName,
+            type: 'chain.stopped',
+            payload: { target: outcome.transitionedTo, reason: decision.reason },
+        });
+    }
+}
diff --git a/apps/api/src/modules/jobs/chain.decision.ts b/apps/api/src/modules/jobs/chain.decision.ts
new file mode 100644
index 00000000..2822a7c6
--- /dev/null
+++ b/apps/api/src/modules/jobs/chain.decision.ts
@@ -0,0 +1,32 @@
+import { NON_STAGE_STATES, type ProjectStages } from '#modules/stages/stage.config.js';
+
+export interface ChainDecision {
+    /** Whether `target` should be enqueued as the card's next stage. */
+    continue: boolean;
+    /** Why the chain stops here. Present only when `continue` is false. */
+    reason?: string;
+}
+
+/**
+ * Whether a card that just transitioned to `target` should be re-enqueued.
+ *
+ * Kept pure and separate from `CardStageJob` on purpose: the dispatcher only ever reports where a
+ * card landed, never whether the queue should keep going, and this is the one place that turns
+ * "landed here" into "keep going" or "stop" — a decision worth testing without a live pg-boss.
+ */
+export const decideChain = (target: string, stages: ProjectStages): ChainDecision => {
+    if ((NON_STAGE_STATES as readonly string[]).includes(target)) {
+        return { continue: false, reason: `${target} is a terminal state` };
+    }
+
+    const stage = stages.stages.find(s => s.name === target);
+    if (!stage) {
+        return { continue: false, reason: `${target} is not a configured stage` };
+    }
+
+    if (stage.mode !== 'agent') {
+        return { continue: false, reason: `${target} is a "${stage.mode}" stage, which needs a human or a command runner, not the queue` };
+    }
+
+    return { continue: true };
+};
diff --git a/apps/api/src/modules/jobs/jobs.module.ts b/apps/api/src/modules/jobs/jobs.module.ts
new file mode 100644
index 00000000..4912867c
--- /dev/null
+++ b/apps/api/src/modules/jobs/jobs.module.ts
@@ -0,0 +1,81 @@
+import { Container, Registry } from 'injectkit';
+import { AppConfig } from '@maroonedsoftware/appconfig';
+import { ServerKitModule } from '@maroonedsoftware/koa';
+import { Logger } from '@maroonedsoftware/logger';
+import { JobBroker, JobRunner, type JobQueuePolicy } from '@maroonedsoftware/jobbroker';
+import { PgBossConnectionProvider, PgBossJobBroker, PgBossJobRegistryMap, PgBossJobRunner } from '@maroonedsoftware/jobbroker/pgboss';
+import { PgBoss } from 'pg-boss';
+import { Duration } from 'luxon';
+import { configNumber, requireConfigString } from '#shared/require.config.js';
+import { CardStageJob } from './card.stage.job.js';
+
+/**
+ * Retry policy for `card.stage`: a couple of quick retries for a transient failure (a dropped
+ * connection, a flaky provider call), then dead-letter rather than retry forever — a stage that
+ * keeps failing needs a human, not an infinite queue.
+ */
+export const CARD_STAGE_POLICY: JobQueuePolicy = {
+    retryLimit: 2,
+    retryDelay: Duration.fromObject({ seconds: 30 }),
+    retryBackoff: true,
+    deadLetter: 'card.stage.dead',
+};
+
+/**
+ * The job queue.
+ *
+ * pg-boss on the same Postgres database as everything else — no separate broker to run or operate.
+ * One queue for now, `card.stage`, which `CardStageJob` re-enqueues onto itself to walk a card
+ * through consecutive `agent` stages without a human re-triggering each one.
+ */
+export const JobsModule: ServerKitModule = {
+    name: 'Jobs',
+    setup: async (registry: Registry, config: AppConfig) => {
+        const dbConfig = {
+            host: requireConfigString(config, 'DATABASE_HOST'),
+            port: configNumber(config, 'DATABASE_PORT', 5432),
+            user: requireConfigString(config, 'DATABASE_USER'),
+            password: requireConfigString(config, 'DATABASE_PASSWORD'),
+            database: requireConfigString(config, 'DATABASE_NAME'),
+        };
+
+        registry
+            .register(PgBoss)
+            .useFactory(container => {
+                const pgboss = new PgBoss(dbConfig);
+                // Mirrors DataModule's pool: an error with no in-flight caller has nowhere else to
+                // go and would otherwise take the process down as an unhandled 'error' event.
+                pgboss.on('error', err => container.get(Logger).error(err));
+                return pgboss;
+            })
+            .asSingleton();
+
+        registry.register(CardStageJob).useClass(CardStageJob).asTransient();
+
+        registry
+            .register(PgBossJobRegistryMap)
+            .useFactory(() => {
+                const registrations = new PgBossJobRegistryMap();
+                registrations.set('card.stage', { job: CardStageJob, policy: CARD_STAGE_POLICY });
+                return registrations;
+            })
+            .asSingleton();
+
+        // Default executor (pg-boss's own pool): enqueues here are not part of a surrounding
+        // database transaction, so there is nothing to override.
+        registry.register(PgBossConnectionProvider).useClass(PgBossConnectionProvider).asSingleton();
+
+        registry.register(JobBroker).useClass(PgBossJobBroker).asSingleton();
+        registry.register(JobRunner).useClass(PgBossJobRunner).asSingleton();
+    },
+    // Started after Data (the pool `card.stage` reads/writes against) and Stages (what
+    // `CardStageJob` dispatches into) — module order in modules.ts controls that.
+    start: async (container: Container) => {
+        await container.get(JobRunner).start();
+    },
+    // Stops accepting new jobs and waits for in-flight ones to finish before Data tears down the
+    // pool underneath them.
+    shutdown: async (container: Container) => {
+        await container.get(JobRunner).stop();
+    },
+};
