# Database — matches the `db` service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=15532
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=wilson
DATABASE_URL=postgres://postgres:postgres@localhost:15532/wilson?sslmode=disable

# The HTTP server.
PORT=13100

# The one project, for now: this repo.
PROJECT_NAME=wilson
PROJECT_CODE_ROOT=/Users/robert/projects/wilson
# Default to siblings of the code repo; worktrees live outside it so a stray `git add .`
# in one card's tree cannot pick up another's.
PROJECT_WORKTREE_ROOT=/Users/robert/projects/.worktrees
PROJECT_RUN_ROOT=/Users/robert/projects/.run

# Model providers. At least one is required; a stage names which it routes to.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Tell a person, off the board, when the machine stops (PROJECT.md, Notification). Both optional;
# leaving NOTIFY_WEBHOOK_URL unset turns notifications off entirely — no HTTP call, no warning, on
# any transition. NOTIFY_BASE_URL is the web app's base URL, used to deep-link a notification to
# the card it is about; it does nothing on its own without a webhook URL to post to.
NOTIFY_WEBHOOK_URL=
NOTIFY_BASE_URL=

# Let the daemon start work itself instead of waiting for `wilson card start`. Off by default: unset
# (or anything other than true/1) runs the daemon as a pure drainer, exactly as before this existed.
# The poller enqueues nothing `wilson card start` would refuse — same dispatchability check, same
# in-flight claim check — and takes at most one card per tick. Set to false (or unset) the moment a
# poller misbehaves; no code change needed. The tick interval is a code constant
# (POLLER_INTERVAL_MS in apps/api/src/modules/jobs/job.runner.config.ts), not an env var.
POLLER_ENABLED=false

# Import GitHub Issues as cards (PROJECT.md, Card sources). All three optional, but leaving
# GITHUB_TOKEN or GITHUB_REPO unset turns the import off entirely — no HTTP call, no warning, on any
# tick. GITHUB_TOKEN is a personal access token with read access to GITHUB_REPO's issues, GITHUB_REPO
# is the repo to import from as "owner/name", and GITHUB_LABEL is the label that marks an issue for
# import (defaults to "wilson-import" when unset — never to importing the whole repo).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_LABEL=

# The Claude Code OAuth token an engine on a registered host signs in with (`wilson host`, stage
# `placement`). An agent VM's own `claude` is signed in only inside the desktop app's sessions, so an
# engine Wilson starts there needs this. Create one with `claude setup-token`. Sent to the host over
# SSH's stdin, never on a command line, and never given to the engine on this machine, which keeps
# signing in the way `claude-config-dir` says. Leave unset to rely on each host's own sign-in.
REMOTE_CLAUDE_CODE_OAUTH_TOKEN=
