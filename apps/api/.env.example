# Database — matches the `db` service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=15532
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=wilson
DATABASE_URL=postgres://postgres:postgres@localhost:15532/wilson?sslmode=disable

# The HTTP server.
PORT=13100

# The one project, for now: this repo.
PROJECT_NAME=wilson
PROJECT_CODE_ROOT=/Users/robert/projects/kanban
PROJECT_BOARD_ROOT=/Users/robert/projects/kanban.board
# Default to siblings of the code repo; worktrees live outside it so a stray `git add .`
# in one card's tree cannot pick up another's.
PROJECT_WORKTREE_ROOT=/Users/robert/projects/.worktrees
PROJECT_RUN_ROOT=/Users/robert/projects/.run

# Model providers. At least one is required; a stage names which it routes to.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Tell a person, off the board, when the machine stops (PROJECT.md, Notification). Both optional;
# leaving NOTIFY_WEBHOOK_URL unset turns notifications off entirely — no HTTP call, no warning, on
# any transition. NOTIFY_BASE_URL is the web app's base URL, used to deep-link a notification to
# the card it is about; it does nothing on its own without a webhook URL to post to.
NOTIFY_WEBHOOK_URL=
NOTIFY_BASE_URL=
