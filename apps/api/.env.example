# Database — matches the `db` service in docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=15532
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=kanban
DATABASE_URL=postgres://postgres:postgres@localhost:15532/kanban?sslmode=disable

# The one project, for now: this repo.
PROJECT_NAME=kanban
PROJECT_CODE_ROOT=/Users/robert/projects/kanban
PROJECT_BOARD_ROOT=/Users/robert/projects/kanban.board
# Default to siblings of the code repo; worktrees live outside it so a stray `git add .`
# in one card's tree cannot pick up another's.
PROJECT_WORKTREE_ROOT=/Users/robert/projects/.worktrees
PROJECT_RUN_ROOT=/Users/robert/projects/.run

# Model providers. At least one is required; a stage names which it routes to.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
