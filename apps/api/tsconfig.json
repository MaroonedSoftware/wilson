{
    "extends": "@repo/config-typescript/base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "#src/*": ["./src/*"],
            "#modules/*": ["./src/modules/*"],
            "#shared/*": ["./src/shared/*"]
        },
        "declaration": false,
        "declarationMap": false
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "dist"]
}
