{
    "rootDir": "../../",
    "cache": ".contractkit/cache",
    "prettier": true,
    "patterns": ["apps/api/data/contracts/**/*.ck"],
    "plugins": {
        "@contractkit/plugin-kotlin": {
            "baseDir": "packages/sdk-kotlin/",
            "packageName": "com.maroonedsoftware.wilson.sdk",
            "sdkName": "WilsonSdk"
        },
        "@contractkit/plugin-typescript": {
            "server": {
                "baseDir": "apps/api/",
                "zod": true,
                "output": {
                    "routes": "src/routes/{filename}.router.ts",
                    "types": "src/generated/{filename}.ts"
                }
            },
            "sdk": {
                "baseDir": "packages/sdk/",
                "name": "wilson",
                "output": {
                    "sdk": "src/{name}.sdk.ts",
                    "types": "src/types/{filename}.ts",
                    "clients": "src/{filename}.client.ts"
                }
            },
            "mcp": {
                "baseDir": "apps/api/",
                "output": {
                    "tools": "src/modules/mcp/generated/{filename}.mcp.ts",
                    "index": "src/modules/mcp/generated/mcp.tools.ts"
                },
                "emitRouter": false,
                "resolve": "perCall",
                "catalog": true
            }
        }
    }
}
