{
    "rootDir": "../../",
    "cache": ".contractkit/cache",
    "prettier": true,
    "patterns": ["apps/api/data/contracts/**/*.ck"],
    "plugins": {
        "@contractkit/plugin-typescript": {
            "server": {
                "baseDir": "apps/api/",
                "zod": true,
                "output": {
                    "routes": "src/generated/{filename}.router.ts",
                    "types": "src/generated/{filename}.ts"
                }
            }
        }
    }
}
