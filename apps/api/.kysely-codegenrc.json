{
    "camelCase": true,
    "customImports": {
        "DateTime": "luxon"
    },
    "dialect": "postgres",
    "includePattern": "wilson.*",
    "outFile": "./src/modules/data/db.ts",
    "overrides": {
        "columns": {
            "wilson.account_authenticators.type": "'totp' | 'hotp'",
            "wilson.account_authenticators.algorithm": "'sha1' | 'sha256' | 'sha512'",
            "wilson.hosts.kind": "Generated<'ssh' | 'worker'>",
            "wilson.engine_tokens.provider": "Generated<'anthropic' | 'openai' | 'xai'>",
            "wilson.engine_tokens.kind": "Generated<'subscription' | 'api_key'>",
            "wilson.plan_turns.role": "'user' | 'assistant'",
            "wilson.chat_threads.engine": "'api' | 'cli'",
            "wilson.chat_messages.role": "'user' | 'assistant'",
            "wilson.chat_pending_actions.status": "Generated<'pending' | 'running' | 'done' | 'failed' | 'declined'>",
            "wilson.reviews.status": "Generated<'open' | 'changes_requested' | 'approved' | 'superseded'>",
            "wilson.review_comments.side": "'old' | 'new'",
            "wilson.review_comments.severity": "Generated<'blocker' | 'concern'>",
            "wilson.review_comments.status": "Generated<'open' | 'resolved' | 'sent'>",
            "wilson.review_turns.role": "'user' | 'assistant'"
        }
    },
    "typeMapping": {
        "int8": "bigint",
        "timestamptz": "DateTime"
    },
    "typeOnlyImports": true,
    "url": "env(DATABASE_URL)"
}
