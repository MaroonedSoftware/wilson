<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            No Avalonia reference, and there must never be one. Everything decidable without a window
            lives here so it can be tested as plain .NET.
        -->
        <RootNamespace>MaroonedSoftware.Wilson.Desktop.Core</RootNamespace>
    </PropertyGroup>

    <!-- Written by tools/macos/make-update-key.sh. A build without it gives notice of updates and installs none. -->
    <ItemGroup Condition="Exists('Updates/update-key.pem')">
        <EmbeddedResource Include="Updates/update-key.pem" LogicalName="update-key.pem" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../packages/sdk-csharp/WilsonSdk.csproj" />
    </ItemGroup>

</Project>
