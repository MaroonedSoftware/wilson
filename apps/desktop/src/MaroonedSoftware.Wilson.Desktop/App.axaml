<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Wilson.Desktop.Views"
    x:Class="MaroonedSoftware.Wilson.Desktop.App"
    Name="Wilson"
    RequestedThemeVariant="Default">

    <!-- Without a menu here, Avalonia adds its own "About Avalonia" to the application menu. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Wilson" Click="OnAbout" />
            <NativeMenuItem Header="Check for Updates…" Click="OnCheckForUpdates" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:StageRoutingRow">
            <StackPanel Spacing="6" Margin="0,0,0,10" AutomationProperties.Name="{Binding Stage}">
                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Stage}" />
                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding ChoosesAdapter}">
                    <RadioButton Content="Claude Agent SDK" IsChecked="{Binding UsesCli}" IsEnabled="{Binding Idle}" />
                    <RadioButton Content="AI SDK" IsChecked="{Binding UsesApi}" IsEnabled="{Binding Idle}" />
                    <RadioButton Content="Codex" IsChecked="{Binding UsesCodex}" IsEnabled="{Binding Idle}" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="180" IsEnabled="{Binding Idle}" IsVisible="{Binding ChoosesProvider}" AutomationProperties.Name="Provider" />
                <TextBox Text="{Binding Model}" PlaceholderText="{Binding Placeholder}" IsEnabled="{Binding Idle}" AutomationProperties.Name="Model" />
                <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" HorizontalAlignment="Left" />
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:StageRoutingControl">
            <StackPanel Spacing="8">
                <Border Background="{DynamicResource Panel}" CornerRadius="6" Padding="10,8" IsVisible="{Binding SharedProvider, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="quiet caution" TextWrapping="Wrap" Text="{Binding SharedProvider}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}" />
                <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Applies from a stage's next run. The AI SDK needs the provider's API key in apps/api/.env and bills per token." />
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ActivityViewModel"><views:ActivityView /></DataTemplate>
        <DataTemplate DataType="vm:AppsViewModel"><views:AppsView /></DataTemplate>
        <DataTemplate DataType="vm:AppViewModel"><views:AppView /></DataTemplate>
        <DataTemplate DataType="vm:LanesViewModel"><views:LanesView /></DataTemplate>
        <DataTemplate DataType="vm:NewProjectViewModel"><views:NewProjectView /></DataTemplate>
        <DataTemplate DataType="vm:GoalsViewModel"><views:GoalsView /></DataTemplate>
        <DataTemplate DataType="vm:HostsViewModel"><views:HostsView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:StepUpViewModel"><views:StepUpView /></DataTemplate>
        <DataTemplate DataType="vm:ChatDockViewModel"><views:ChatDockView /></DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="vm:SignInViewModel"><views:SignInView /></DataTemplate>
        <DataTemplate DataType="vm:BoardViewModel"><views:BoardView /></DataTemplate>
        <DataTemplate DataType="vm:CardViewModel"><views:CardView /></DataTemplate>
        <DataTemplate DataType="vm:CardFormViewModel"><views:CardFormView /></DataTemplate>
        <DataTemplate DataType="vm:PlanViewModel"><views:PlanView /></DataTemplate>
        <DataTemplate DataType="vm:ThreadsViewModel"><views:ThreadsView /></DataTemplate>
        <DataTemplate DataType="vm:ChatViewModel"><views:ChatView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Serif">Georgia, Times New Roman, serif</FontFamily>
            <FontFamily x:Key="Mono">SF Mono, Menlo, Consolas, monospace</FontFamily>
            <StreamGeometry x:Key="IconChevronRight">M7.64582 4.14708C7.84073 3.95147 8.15731 3.9509 8.35292 4.14582L13.8374 9.6108C14.0531 9.82574 14.0531 10.1751 13.8374 10.39L8.35292 15.855C8.15731 16.0499 7.84073 16.0493 7.64582 15.8537C7.4509 15.6581 7.45147 15.3415 7.64708 15.1466L12.8117 10.0004L7.64708 4.85418C7.45147 4.65927 7.4509 4.34269 7.64582 4.14708Z</StreamGeometry>
            <StreamGeometry x:Key="IconEye">M3.25909 11.6021C3.94254 8.32689 6.79437 6 10 6C13.2057 6 16.0574 8.32688 16.7409 11.6021C16.7974 11.8725 17.0622 12.0459 17.3325 11.9895C17.6029 11.933 17.7763 11.6682 17.7199 11.3979C16.9425 7.67312 13.6934 5 10 5C6.3066 5 3.05742 7.67311 2.28017 11.3979C2.22377 11.6682 2.39718 11.933 2.6675 11.9895C2.93782 12.0459 3.20268 11.8725 3.25909 11.6021ZM10 8C8.067 8 6.5 9.567 6.5 11.5C6.5 13.433 8.067 15 10 15C11.933 15 13.5 13.433 13.5 11.5C13.5 9.567 11.933 8 10 8ZM7.5 11.5C7.5 10.1193 8.61929 9 10 9C11.3807 9 12.5 10.1193 12.5 11.5C12.5 12.8807 11.3807 14 10 14C8.61929 14 7.5 12.8807 7.5 11.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconEyeOff">M2.85355 2.14645C2.65829 1.95118 2.34171 1.95118 2.14645 2.14645C1.95118 2.34171 1.95118 2.65829 2.14645 2.85355L5.6453 6.35239C3.97044 7.49179 2.7234 9.27384 2.28017 11.3979C2.22377 11.6682 2.39718 11.9331 2.6675 11.9895C2.93782 12.0459 3.20268 11.8725 3.25909 11.6021C3.6629 9.66699 4.82367 8.06291 6.36714 7.07422L7.95336 8.66045C7.07297 9.29611 6.5 10.3311 6.5 11.5C6.5 13.433 8.067 15 10 15C11.1689 15 12.2039 14.427 12.8396 13.5466L17.1464 17.8536C17.3417 18.0488 17.6583 18.0488 17.8536 17.8536C18.0488 17.6583 18.0488 17.3417 17.8536 17.1464L2.85355 2.14645ZM12.1194 12.8265C11.6773 13.5314 10.8934 14 10 14C8.61929 14 7.5 12.8807 7.5 11.5C7.5 10.6066 7.96863 9.82265 8.67348 9.38057L12.1194 12.8265ZM10.1235 8.00214L13.4979 11.3765C13.4342 9.54169 11.9583 8.06576 10.1235 8.00214ZM10 6C9.43016 6 8.87149 6.07353 8.33419 6.21285L7.53113 5.40979C8.31349 5.14331 9.14485 5 10 5C13.6934 5 16.9425 7.67312 17.7199 11.3979C17.7763 11.6682 17.6029 11.933 17.3325 11.9895C17.0622 12.0459 16.7974 11.8725 16.7409 11.6021C16.0574 8.32688 13.2057 6 10 6Z</StreamGeometry>
            <!-- Tabler's outlines, as the web app's, drawn with Path.stroke. -->
            <StreamGeometry x:Key="IconArrowUp">M12 5V19M18 11L12 5M6 11L12 5</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M12 5V19M5 12H19</StreamGeometry>
            <StreamGeometry x:Key="IconPaperclip">M15 7L8.5 13.5A1.5 1.5 0 0 0 11.5 16.5L18 10A3 3 0 0 0 12 4L5.5 10.5A4.5 4.5 0 0 0 14.5 19.5L21 13</StreamGeometry>
            <StreamGeometry x:Key="IconDots">M5 12H5.01M12 12H12.01M19 12H19.01</StreamGeometry>
            <StreamGeometry x:Key="IconBolt">M13 3V10H19L11 21V14H5L13 3Z</StreamGeometry>
            <StreamGeometry x:Key="IconDockBottom">M4 6A2 2 0 0 1 6 4H18A2 2 0 0 1 20 6V18A2 2 0 0 1 18 20H6A2 2 0 0 1 4 18ZM4 15H20</StreamGeometry>
            <StreamGeometry x:Key="IconDockRight">M4 6A2 2 0 0 1 6 4H18A2 2 0 0 1 20 6V18A2 2 0 0 1 18 20H6A2 2 0 0 1 4 18ZM15 4V20</StreamGeometry>
            <StreamGeometry x:Key="IconMaximize">M4 8V6A2 2 0 0 1 6 4H8M16 4H18A2 2 0 0 1 20 6V8M20 16V18A2 2 0 0 1 18 20H16M8 20H6A2 2 0 0 1 4 18V16</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M18 6L6 18M6 6L18 18</StreamGeometry>
            <StreamGeometry x:Key="IconRailClose">M15 6L9 12L15 18</StreamGeometry>
            <StreamGeometry x:Key="IconRailOpen">M9 6L15 12L9 18</StreamGeometry>
            <StreamGeometry x:Key="IconAlert">M12 9V13M12 16H12.01M10.4 3.6L2.3 17.1C1.6 18.4 2.4 20 3.9 20H20.1C21.6 20 22.4 18.4 21.7 17.1L13.6 3.6C12.9 2.4 11.1 2.4 10.4 3.6Z</StreamGeometry>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Ink" Color="#2b2b2a" />
                    <SolidColorBrush x:Key="InkRaised" Color="#454543" />
                    <SolidColorBrush x:Key="OnInk" Color="#fbfbfa" />
                    <SolidColorBrush x:Key="Panel" Color="#f4f4f3" />
                    <SolidColorBrush x:Key="Tile" Color="#ffffff" />
                    <SolidColorBrush x:Key="Line" Color="#d9d9d6" />
                    <SolidColorBrush x:Key="Quiet" Color="#6b6b68" />
                    <SolidColorBrush x:Key="Flag" Color="#a33a12" />
                    <SolidColorBrush x:Key="Added" Color="#dcf3e1" />
                    <SolidColorBrush x:Key="Removed" Color="#fbe0de" />
                    <SolidColorBrush x:Key="Caution" Color="#a16207" />
                    <SolidColorBrush x:Key="Marked" Color="#fbe9a8" />
                    <SolidColorBrush x:Key="MarkedActive" Color="#f5cf5c" />
                    <SolidColorBrush x:Key="Good" Color="#2f7d4a" />
                    <!-- A finished goal, `statusColor`'s blue. -->
                    <SolidColorBrush x:Key="Done" Color="#1f63b0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Ink" Color="#e8e8e5" />
                    <SolidColorBrush x:Key="InkRaised" Color="#ffffff" />
                    <SolidColorBrush x:Key="OnInk" Color="#222221" />
                    <SolidColorBrush x:Key="Panel" Color="#2a2a29" />
                    <SolidColorBrush x:Key="Tile" Color="#343433" />
                    <SolidColorBrush x:Key="Line" Color="#464644" />
                    <SolidColorBrush x:Key="Quiet" Color="#a8a8a4" />
                    <SolidColorBrush x:Key="Flag" Color="#f09a6c" />
                    <SolidColorBrush x:Key="Added" Color="#1f3d29" />
                    <SolidColorBrush x:Key="Removed" Color="#4a2523" />
                    <SolidColorBrush x:Key="Caution" Color="#e6b84d" />
                    <SolidColorBrush x:Key="Marked" Color="#5c4a14" />
                    <SolidColorBrush x:Key="MarkedActive" Color="#8f7320" />
                    <SolidColorBrush x:Key="Good" Color="#6cc58d" />
                    <SolidColorBrush x:Key="Done" Color="#7aaeea" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Monochrome, because the brand has one colour (brand/README.md). -->
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#c9c9c6" RegionColor="#222221" />
                <ColorPaletteResources x:Key="Light" Accent="#2b2b2a" RegionColor="#fbfbfa" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource Serif}" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="TextBlock.quiet, SelectableTextBlock.quiet">
            <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.quiet.stale">
            <Setter Property="Foreground" Value="{DynamicResource Caution}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{DynamicResource Tile}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ink}" />
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Button.icon, ToggleButton.icon">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
        </Style>
        <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Button.icon:disabled Path.stroke">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Path.stroke">
            <Setter Property="Stroke" Value="{DynamicResource Quiet}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="Viewbox.icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6,30,6" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Button.section">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="Button.section /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.section:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.section.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Button.flag">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Button.flag /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Flag}" />
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.flag.draining /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Caution}" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Button.chip.current /template/ ContentPresenter#PART_ContentPresenter, Button.chip.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
        </Style>
        <Style Selector="Button.attach">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.attach /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button.attach:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="Button.remove">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.remove /template/ ContentPresenter#PART_ContentPresenter, Button.remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.send">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.send /template/ ContentPresenter#PART_ContentPresenter, Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button.send.ready /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="Button.send.ready:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkRaised}" />
        </Style>
        <Style Selector="Button.send.ready Path.stroke">
            <Setter Property="Stroke" Value="{DynamicResource OnInk}" />
        </Style>
        <Style Selector="Border.composer">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,6,6,6" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>
        <Style Selector="Border.composer:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Quiet}" />
        </Style>
        <Style Selector="Border.composer.dropping">
            <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="TextBox.bare">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.key">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.good">
            <Setter Property="Foreground" Value="{DynamicResource Good}" />
        </Style>
        <Style Selector="TextBlock.quiet.good">
            <Setter Property="Foreground" Value="{DynamicResource Good}" />
        </Style>
        <Style Selector="TextBlock.quiet.caution">
            <Setter Property="Foreground" Value="{DynamicResource Caution}" />
        </Style>
        <Style Selector="TextBlock.quiet.done">
            <Setter Property="Foreground" Value="{DynamicResource Done}" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource Flag}" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.danger.confirming">
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
        </Style>
        <Style Selector="Button.danger.confirming /template/ ContentPresenter#PART_ContentPresenter, Button.danger.confirming:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Flag}" />
            <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
        </Style>
        <Style Selector="Border.dock-handle">
            <Setter Property="Background" Value="{DynamicResource Line}" />
        </Style>
        <Style Selector="Border.dock-handle:pointerover, Border.dock-handle:focus">
            <Setter Property="Background" Value="{DynamicResource Quiet}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.codeblock">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.answer">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.error, SelectableTextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource Flag}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Styles>
</Application>
