<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Wilson.Desktop.Views"
    xmlns:core="using:MaroonedSoftware.Wilson.Desktop.Core.Chat"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.ChatView"
    x:DataType="vm:ChatViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:UserEntry">
            <StackPanel HorizontalAlignment="Right" MaxWidth="640" Spacing="6">
                <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatImageRow">
                            <Border CornerRadius="12" ClipToBounds="True" Margin="4,0,0,4" Background="{DynamicResource Panel}" ToolTip.Tip="{Binding Filename}">
                                <Panel>
                                    <Image Source="{Binding Picture}" MaxWidth="320" MaxHeight="240" Stretch="Uniform" />
                                    <TextBlock Classes="quiet" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="14,8" />
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border HorizontalAlignment="Right" Background="{DynamicResource Panel}" CornerRadius="16" Padding="14,8" IsVisible="{Binding HasText}">
                    <SelectableTextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AnswerEntry">
            <StackPanel Spacing="8">
                <views:ChatActivityLine Items="{Binding Activity}" IsVisible="{Binding Ran}" />
                <views:MarkdownView Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ActionRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Margin="0,2,8,0" VerticalAlignment="Top" IsVisible="{Binding Awaiting}"><Path Classes="stroke" Data="{StaticResource IconAlert}" Stroke="{DynamicResource Caution}" /></Viewbox>
                        <Border DockPanel.Dock="Right" Classes="badge" Margin="8,0,0,0" VerticalAlignment="Top" IsVisible="{Binding !Awaiting}">
                            <TextBlock Classes="quiet" Classes.error="{Binding Failed}" Text="{Binding Status}" FontSize="11" />
                        </Border>
                        <StackPanel Spacing="2">
                            <SelectableTextBlock Text="{Binding Summary}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                            <TextBlock Classes="quiet" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding !#RawArguments.IsChecked}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:ChatActionField">
                                <Panel Margin="0,0,0,8">
                                    <Grid IsVisible="{Binding IsLine}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ActionFieldLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Classes="quiet" Text="{Binding Label}" Margin="0,0,12,0" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                    <StackPanel Spacing="4" IsVisible="{Binding !IsLine}">
                                        <TextBlock Classes="quiet" Text="{Binding Label}" />
                                        <!-- A long body scrolls in its own box, so Confirm stays near the summary. -->
                                        <Border Classes="codeblock" IsVisible="{Binding IsProse}">
                                            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                                                <views:MarkdownView Text="{Binding Value}" />
                                            </ScrollViewer>
                                        </Border>
                                        <Border Classes="codeblock" IsVisible="{Binding IsJson}"><SelectableTextBlock Classes="mono" Text="{Binding Value}" /></Border>
                                    </StackPanel>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Rendered Markdown can hide a link's address, so what will really be sent stays one press away. -->
                    <Border Classes="codeblock" IsVisible="{Binding #RawArguments.IsChecked}">
                        <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Classes="mono" Text="{Binding Arguments}" />
                        </ScrollViewer>
                    </Border>
                    <DockPanel>
                        <ToggleButton x:Name="RawArguments" DockPanel.Dock="Left" Content="Raw JSON" FontSize="12" IsVisible="{Binding HasFields}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding Awaiting}">
                            <Button Classes="ghost" Content="Decline" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).DeclineCommand}" CommandParameter="{Binding}" />
                            <Button Classes="primary" Content="Confirm" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).ConfirmCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </DockPanel>
                    <SelectableTextBlock Classes="error" FontSize="12" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:QuestionCard">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel Spacing="12">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Margin="0,2,8,0" VerticalAlignment="Top" IsVisible="{Binding Awaiting}"><Path Classes="stroke" Data="{StaticResource IconAlert}" Stroke="{DynamicResource Caution}" /></Viewbox>
                        <Border DockPanel.Dock="Right" Classes="badge" Margin="8,0,0,0" VerticalAlignment="Top" IsVisible="{Binding !Awaiting}">
                            <TextBlock Classes="quiet" Text="{Binding Outcome}" FontSize="11" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Wilson asks" FontSize="14" FontWeight="Medium" />
                            <TextBlock Classes="quiet" Text="{Binding Expires}" IsVisible="{Binding Awaiting}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Prompts}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuestionPrompt">
                                <StackPanel Spacing="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <SelectableTextBlock Classes="quiet" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <SelectableTextBlock Text="{Binding Answered}" TextWrapping="Wrap" IsVisible="{Binding HasAnswer}" />
                                    <StackPanel Spacing="6" IsVisible="{Binding $parent[ItemsControl].((vm:QuestionCard)DataContext).Awaiting}">
                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QuestionOption">
                                                    <Panel>
                                                        <RadioButton GroupName="{Binding Group}" IsChecked="{Binding IsChosen}" IsVisible="{Binding !$parent[ItemsControl].((vm:QuestionPrompt)DataContext).MultiSelect}" IsEnabled="{Binding $parent[ItemsControl;1].((vm:QuestionCard)DataContext).Editable}">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                        <CheckBox IsChecked="{Binding IsChosen}" IsVisible="{Binding $parent[ItemsControl].((vm:QuestionPrompt)DataContext).MultiSelect}" IsEnabled="{Binding $parent[ItemsControl;1].((vm:QuestionCard)DataContext).Editable}">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding Other}" PlaceholderText="Other: something else…" AcceptsReturn="False" TextWrapping="Wrap" MaxLength="500" IsEnabled="{Binding $parent[ItemsControl].((vm:QuestionCard)DataContext).Editable}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="primary" HorizontalAlignment="Right" Content="Submit" IsVisible="{Binding Awaiting}" IsEnabled="{Binding CanSubmit}" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).AnswerCommand}" CommandParameter="{Binding}" />
                    <SelectableTextBlock Classes="error" FontSize="12" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <!-- A new chat: the greeting and the composer, in the middle of the page. -->
        <StackPanel IsVisible="{Binding Empty}" VerticalAlignment="Center" MaxWidth="760" Margin="16" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="What should we do?" HorizontalAlignment="Center" />
                <TextBlock Classes="quiet" Text="{Binding Promise}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <views:ChatComposerView IsVisible="{Binding Empty}" />
            <ItemsControl ItemsSource="{Binding Starters}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Classes="chip" Content="{Binding}" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SuggestCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- The conversation: the column scrolls, and the composer stays at its foot. -->
        <DockPanel IsVisible="{Binding Talking}">
            <StackPanel DockPanel.Dock="Bottom" MaxWidth="760" Margin="16,4,16,16" Spacing="8">
                <SelectableTextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Classes="chip" Content="{Binding}" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SuggestCommand}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:ChatComposerView IsVisible="{Binding Talking}" />
            </StackPanel>
            <ScrollViewer x:Name="Scroller">
                <StackPanel MaxWidth="760" Margin="16,20" Spacing="16">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding SentImages}" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingImage">
                                <Border CornerRadius="12" ClipToBounds="True" Margin="4,0,0,4">
                                    <Image Source="{Binding Picture}" MaxWidth="320" MaxHeight="240" Stretch="Uniform" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border HorizontalAlignment="Right" MaxWidth="640" Background="{DynamicResource Panel}" CornerRadius="16" Padding="14,8" IsVisible="{Binding Sent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding Sent}" FontSize="14" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Spacing="8" IsVisible="{Binding Answering}">
                        <views:ChatActivityLine Items="{Binding Working}" />
                        <views:MarkdownView Text="{Binding Draft}" />
                        <TextBlock Classes="quiet" FontSize="13" Text="Working on it…" IsVisible="{Binding Thinking}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
