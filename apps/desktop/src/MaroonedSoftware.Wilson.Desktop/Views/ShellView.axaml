<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.ShellView"
    x:DataType="vm:ShellViewModel">
    <Panel>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="16,6" IsVisible="{Binding Updates.Visible, FallbackValue=False}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="View release" Command="{Binding Updates.ViewReleaseCommand, FallbackValue={x:Null}}" IsVisible="{Binding Updates.CanView, FallbackValue=False}" />
                <Button DockPanel.Dock="Right" Content="Restart to update" Command="{Binding Updates.RestartCommand, FallbackValue={x:Null}}" IsVisible="{Binding Updates.Ready, FallbackValue=False}" IsEnabled="{Binding !Updates.Installing, FallbackValue=False}" />
                <TextBlock Text="{Binding Updates.Message, FallbackValue={x:Null}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,8" IsVisible="{Binding SignedIn}">
            <DockPanel LastChildFill="False">
                <Button Classes="section" Command="{Binding ShowChatCommand}" Margin="-10,0,14,0" ToolTip.Tip="Home" AutomationProperties.Name="Home">
                    <TextBlock Classes="title" Text="Wilson" />
                </Button>
                <Button Classes="section" Classes.current="{Binding OnChat}" Content="Chat" Command="{Binding ShowChatCommand}" VerticalAlignment="Center" />
                <Button Classes="section" Classes.current="{Binding OnBoard}" Content="Board" Command="{Binding ShowBoardCommand}" VerticalAlignment="Center" />
                <Button Classes="section" Classes.current="{Binding OnProjects}" Content="Projects" Command="{Binding ShowProjectsCommand}" VerticalAlignment="Center" />
                <Button Classes="section" Classes.current="{Binding OnHosts}" Content="Hosts" Command="{Binding ShowHostsCommand}" VerticalAlignment="Center" />
                <Button Classes="section" Classes.current="{Binding OnSettings}" Content="Settings" Command="{Binding ShowSettingsCommand}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Sign out" Command="{Binding SignOutCommand}" VerticalAlignment="Center" />
                <ToggleButton DockPanel.Dock="Right" Content="Dock" IsChecked="{Binding DockOpen, Mode=OneWay}" Command="{Binding ToggleDockCommand}" IsVisible="{Binding CanDock}" ToolTip.Tip="The chat beside this page (Cmd+J)" AutomationProperties.Name="Chat dock" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{Binding Appearance}" Command="{Binding NextAppearanceCommand}" ToolTip.Tip="Appearance: press for the next" AutomationProperties.Name="Appearance" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Activity" Command="{Binding ShowActivityCommand}" IsVisible="{Binding Feed, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Lanes" Command="{Binding ShowLanesCommand}" IsVisible="{Binding Feed, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Feed.RefreshCommand, FallbackValue={x:Null}}" IsVisible="{Binding Feed, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="live" ToolTip.Tip="Updates as cards move" IsVisible="{Binding Feed.Live, FallbackValue=False}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="snapshot" ToolTip.Tip="Not connected: see Refresh" IsVisible="{Binding !Feed.Live, FallbackValue=False}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Classes="flag draining" Content="{Binding DrainBadge}" Command="{Binding ShowSettingsCommand}" IsVisible="{Binding DrainBadge, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Classes="flag" Content="{Binding Flagged}" Command="{Binding ShowFlaggedCommand}" IsVisible="{Binding Flagged, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
            <ContentControl Content="{Binding Page}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <DockPanel Grid.Column="1" Width="{Binding Dock.Width}" IsVisible="{Binding RightDock, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border x:Name="RightHandle" DockPanel.Dock="Left" Classes="dock-handle" Width="6" Cursor="SizeWestEast" Focusable="True" AutomationProperties.Name="Resize the chat" />
                <ContentControl Content="{Binding RightDock}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </DockPanel>
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Height="{Binding Dock.Height}" IsVisible="{Binding BottomDock, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border x:Name="BottomHandle" DockPanel.Dock="Top" Classes="dock-handle" Height="6" Cursor="SizeNorthSouth" Focusable="True" AutomationProperties.Name="Resize the chat" />
                <ContentControl Content="{Binding BottomDock}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </DockPanel>
        </Grid>
    </DockPanel>
    <ContentControl Content="{Binding StepUp}" IsVisible="{Binding StepUp, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Panel>
</UserControl>
