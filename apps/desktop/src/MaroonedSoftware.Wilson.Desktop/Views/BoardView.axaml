<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Wilson.Desktop.Views"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.BoardView"
    x:DataType="vm:BoardViewModel">
    <UserControl.Styles>
        <Style Selector="Border.column"><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Width" Value="250" /><Setter Property="Padding" Value="8" /></Style>
        <Style Selector="Border.column.collapsed"><Setter Property="Width" Value="40" /><Setter Property="Padding" Value="2,8" /></Style>
        <Style Selector="Border.column.target"><Setter Property="BorderBrush" Value="{DynamicResource Ink}" /></Style>
        <Style Selector="Button.tile.dragged"><Setter Property="Opacity" Value="0.4" /></Style>
        <Style Selector="Button.tile.pending"><Setter Property="Opacity" Value="0.6" /></Style>
    </UserControl.Styles>
    <Grid>
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Classes="title" Text="{Binding Heading}" Margin="0,0,16,0" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" MinWidth="160" VerticalAlignment="Center" />
            <TextBox Text="{Binding Filter}" PlaceholderText="Filter by id or title" Width="180" Margin="8,0,0,0" VerticalAlignment="Center" />
            <ToggleButton Content="Flagged" IsChecked="{Binding FlaggedOnly}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <Button Content="New card" Command="{Binding NewCardCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="{Binding Count}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Classes="quiet" FontSize="14" Text="Nothing is flagged right now." IsVisible="{Binding NothingFlagged}" Margin="0,0,0,8" />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BoardColumn">
                        <Border Classes="column" Classes.target="{Binding Target}" Classes.collapsed="{Binding Collapsed}" Background="{DynamicResource Panel}" CornerRadius="4">
                            <Grid>
                            <Button Classes="icon" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Top" HorizontalContentAlignment="Center" Padding="2,0" IsVisible="{Binding Collapsed}" Command="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).ToggleCollapsedCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Name, StringFormat='Expand {0}'}" AutomationProperties.Name="{Binding Name, StringFormat='Expand {0} column'}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Classes="quiet" Text="{Binding Count}" HorizontalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Flag}" HorizontalAlignment="Center" ToolTip.Tip="{Binding Flagged}" IsVisible="{Binding Flagged, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <LayoutTransformControl HorizontalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform><RotateTransform Angle="90" /></LayoutTransformControl.LayoutTransform>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    </LayoutTransformControl>
                                    <Viewbox Classes="icon" Width="14" Height="14"><Path Classes="stroke" Data="{StaticResource IconRailOpen}" /></Viewbox>
                                </StackPanel>
                            </Button>
                            <DockPanel IsVisible="{Binding !Collapsed}">
                                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                    <Button DockPanel.Dock="Right" Classes="icon" Padding="2" Margin="6,0,0,0" Command="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).ToggleCollapsedCommand}" CommandParameter="{Binding}" ToolTip.Tip="Collapse" AutomationProperties.Name="{Binding Name, StringFormat='Collapse {0} column'}">
                                        <Viewbox Width="14" Height="14"><Path Classes="stroke" Data="{StaticResource IconRailClose}" /></Viewbox>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="{Binding Count}" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Flagged}" Foreground="{DynamicResource Flag}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding Flagged, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BoardTile">
                                                <Button Classes="tile" Classes.dragged="{Binding Dragged}" Classes.pending="{Binding Pending}" Command="{Binding $parent[UserControl].((vm:BoardViewModel)DataContext).OpenCardCommand}" CommandParameter="{Binding Card}">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <views:StateIcon Face="{Binding Face}" Foreground="{DynamicResource Quiet}" Backing="{DynamicResource Tile}" Width="16" Height="16" IsVisible="{Binding Face, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <TextBlock Classes="quiet" Text="{Binding Card.Id}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Card.Title}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Flag}" Foreground="{DynamicResource Flag}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Flag, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Text="{Binding Blocked}" Foreground="{DynamicResource Caution}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Blocked, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Classes="quiet" Text="{Binding Deps}" IsVisible="{Binding Deps, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Classes="quiet" Text="{Binding Pieces}" IsVisible="{Binding Pieces, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Classes="quiet" Text="{Binding InStage}" IsVisible="{Binding InStage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Classes="quiet" Classes.stale="{Binding Stale}" Text="{Binding LastEvent}" IsVisible="{Binding LastEvent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    <Canvas IsHitTestVisible="False">
        <Border x:Name="Ghost" IsVisible="False" Width="234" Opacity="0.95" Background="{DynamicResource Tile}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6">
            <StackPanel Spacing="2">
                <TextBlock x:Name="GhostId" Classes="quiet" />
                <TextBlock x:Name="GhostTitle" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
