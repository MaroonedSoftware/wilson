<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.AppView"
    x:DataType="vm:AppViewModel">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Back" Command="{Binding Shell.BackCommand}" Margin="0,0,10,0" />
            <TextBlock Classes="title" Text="{Binding Name}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Top" Spacing="8" IsVisible="{Binding Left}">
            <TextBlock Classes="error" TextWrapping="Wrap" Text="This app tried to leave its page. It was stopped and closed, because an app that navigates away is no longer running inside its restrictions." />
            <Button Content="Open it again" Command="{Binding OpenAgainCommand}" />
        </StackPanel>
        <Panel x:Name="Host" />
    </DockPanel>
</UserControl>
