<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.ThreadsView"
    x:DataType="vm:ThreadsViewModel">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Classes="title" Text="Wilson" Margin="0,0,16,0" VerticalAlignment="Center" />
            <Button Content="Board" Command="{Binding OpenBoardCommand}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Sign out" Command="{Binding Shell.SignOutCommand}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="240,*">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="New chat" Command="{Binding StartThreadCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Threads}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThreadRow">
                                <Button Classes="tile" Classes.current="{Binding Current}" Command="{Binding $parent[UserControl].((vm:ThreadsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <TextBlock Grid.Column="1" Classes="quiet" Text="No chats yet. Start one with New chat." Margin="16,0,0,0" IsVisible="{Binding NoChats}" />
            <ContentControl Grid.Column="1" Content="{Binding Chat}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </DockPanel>
</UserControl>
