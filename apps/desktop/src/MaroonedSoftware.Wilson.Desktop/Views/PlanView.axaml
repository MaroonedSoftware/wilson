<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    xmlns:views="using:MaroonedSoftware.Wilson.Desktop.Views"
    xmlns:core="using:MaroonedSoftware.Wilson.Desktop.Core.Planning"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.PlanView"
    x:DataType="vm:PlanViewModel">
    <UserControl.Styles>
        <Style Selector="Button.commentrow">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.commentrow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.commentrow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.commentrow.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
    </UserControl.Styles>
    <Grid>
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Close session" Command="{Binding CloseSessionCommand}" IsEnabled="{Binding Open}" />
            <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="live" IsVisible="{Binding Live}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="Back" Command="{Binding Shell.BackCommand}" Margin="0,0,10,0" />
            <TextBlock Classes="title" Text="{Binding Heading}" />
        </DockPanel>
        <SelectableTextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,6" />
        <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,6" />
        <Grid ColumnDefinitions="*,12,*">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0" IsEnabled="{Binding Open}">
                    <TextBox PlaceholderText="Say what the plan needs" Text="{Binding Composer}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" IsEnabled="{Binding Idle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding Idle}">
                        <Button Content="Send" Command="{Binding SendCommand}" />
                        <Button Content="Suggest cuts" Command="{Binding AskForCutsCommand}" />
                        <Button Content="Write the draft" Command="{Binding AskForDraftCommand}" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TranscriptLine"><StackPanel Margin="0,0,0,10" Spacing="2"><TextBlock Classes="quiet" Text="{Binding Who}" /><views:MarkdownView Text="{Binding Text}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <SelectableTextBlock Classes="quiet" Text="{Binding Sent}" TextWrapping="Wrap" IsVisible="{Binding Sending}" Margin="0,0,0,8" />
                        <views:MarkdownView Text="{Binding Pending}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6" IsVisible="{Binding Collision}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Use the agent's version" Command="{Binding UseIncomingCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="The agent wrote a new draft while you were editing. Your edit is kept below." TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Approve…" Command="{Binding AskApproveCommand}" IsEnabled="{Binding CanApprove}" />
                    <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="unsaved" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding Unsaved}" />
                    <ToggleButton Content="Preview" IsChecked="{Binding Preview}" HorizontalAlignment="Left" IsEnabled="{Binding Open}" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="quiet" Text="Select a passage to comment on it." IsVisible="{Binding Preview}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="190">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanCommentRow">
                                        <DockPanel Margin="0,0,10,6">
                                            <Button DockPanel.Dock="Right" Content="Resolve" IsVisible="{Binding !Resolved}" VerticalAlignment="Top" Command="{Binding $parent[UserControl].((vm:PlanViewModel)DataContext).ResolveCommentCommand}" CommandParameter="{Binding}" />
                                            <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="Resolved" IsVisible="{Binding Resolved}" />
                                            <Button Classes="commentrow" Classes.active="{Binding Active}" Command="{Binding $parent[UserControl].((vm:PlanViewModel)DataContext).ShowCommentCommand}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Classes="quiet" Text="{Binding Quote}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="quiet" FontWeight="SemiBold" Text="Outdated comments" IsVisible="{Binding !!Outdated.Count}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Outdated}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanCommentRow">
                                        <DockPanel Margin="0,0,10,6">
                                            <Button DockPanel.Dock="Right" Content="Resolve" IsVisible="{Binding !Resolved}" VerticalAlignment="Top" Command="{Binding $parent[UserControl].((vm:PlanViewModel)DataContext).ResolveCommentCommand}" CommandParameter="{Binding}" />
                                            <TextBlock DockPanel.Dock="Right" Classes="quiet" Text="Resolved" IsVisible="{Binding Resolved}" />
                                            <StackPanel>
                                                <TextBlock Classes="quiet" Text="{Binding Quote}" TextDecorations="Strikethrough" TextTrimming="CharacterEllipsis" />
                                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <Grid>
                    <TextBox PlaceholderText="The draft" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" VerticalContentAlignment="Top" IsVisible="{Binding !Preview}" />
                    <ScrollViewer IsVisible="{Binding Preview}">
                        <Grid Margin="0,0,10,0">
                            <views:MarkdownView x:Name="DraftPreview" Text="{Binding Draft}" Marks="{Binding Marks}" />
                            <Canvas x:Name="Overlay">
                                <Border x:Name="CommentCard" Width="300" Padding="10" CornerRadius="6" Background="{DynamicResource Tile}" BorderBrush="{DynamicResource Line}" BorderThickness="1" BoxShadow="0 2 10 0 #30000000" IsVisible="{Binding CardAnchor, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Panel>
                                        <StackPanel Spacing="6" IsVisible="{Binding Composing}">
                                            <TextBox x:Name="CommentBox" PlaceholderText="Comment on this passage" Text="{Binding CommentText}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommentCommand}" />
                                                <Button Classes="primary" Content="Comment" Command="{Binding AddCommentCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Spacing="6" IsVisible="{Binding Viewing}">
                                            <SelectableTextBlock Text="{Binding Active.Text, FallbackValue={x:Null}}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <TextBlock Classes="quiet" Text="Resolved" VerticalAlignment="Center" IsVisible="{Binding Active.Resolved, FallbackValue=False}" />
                                                <Button Classes="ghost" Content="Close" Command="{Binding CloseCommentCommand}" />
                                                <Button Content="Resolve" Command="{Binding ResolveCommentCommand}" CommandParameter="{Binding Active}" IsVisible="{Binding !Active.Resolved, FallbackValue=False}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
    <Border IsVisible="{Binding Approving}" Background="#80000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" MaxHeight="560" Padding="18" CornerRadius="6" Background="{DynamicResource Tile}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="title" FontSize="18" Text="{Binding ApproveTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Classes="ghost" Content="Cancel" Command="{Binding CancelApproveCommand}" />
                    <Button Classes="primary" Content="Write this version" Command="{Binding SaveDraftCommand}" />
                </StackPanel>
                <SelectableTextBlock DockPanel.Dock="Bottom" Classes="error" Text="{Binding ApproveError}" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding ApproveError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock DockPanel.Dock="Top" Classes="quiet" Text="No changes." IsVisible="{Binding !ApproveLines.Count}" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ApproveLines}" Margin="0,0,10,0">
                        <ItemsControl.Styles>
                            <Style Selector="Border.added"><Setter Property="Background" Value="{DynamicResource Added}" /></Style>
                            <Style Selector="Border.removed"><Setter Property="Background" Value="{DynamicResource Removed}" /></Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:DraftDiffLine">
                                <Border Classes.added="{Binding Added}" Classes.removed="{Binding !Added}" Padding="4,1">
                                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
