<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SwitchSetting">
            <StackPanel Spacing="4">
                <DockPanel IsVisible="{Binding Loaded}">
                    <ToggleSwitch DockPanel.Dock="Left" IsChecked="{Binding On}" IsEnabled="{Binding Idle}" OnContent="" OffContent="" VerticalAlignment="Top" AutomationProperties.Name="{Binding Label}" />
                    <StackPanel Spacing="1" Margin="4,0,0,0">
                        <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" />
                        <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Description}" />
                    </StackPanel>
                </DockPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberSetting">
            <StackPanel Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding Loaded}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Description}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding Draft}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Step}" FormatString="0" Width="180" IsEnabled="{Binding Idle}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" />
                    </StackPanel>
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TextSetting">
            <StackPanel Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding Loaded}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Description}" />
                    <TextBox Text="{Binding Draft}" PlaceholderText="{Binding Placeholder}" IsEnabled="{Binding Idle}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" HorizontalAlignment="Left" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <SelectableTextBlock Classes="quiet" Text="{Binding StillSaved}" IsVisible="{Binding StillSaved, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AccountRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" AutomationProperties.Name="{Binding Name}">
                <StackPanel Spacing="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsEnabled="{Binding Control.Idle}">
                            <Button Classes="icon" Padding="4" ToolTip.Tip="Move up" AutomationProperties.Name="Move up" IsVisible="{Binding InRotation}" IsEnabled="{Binding CanMoveUp}" Command="{Binding MoveUpCommand}">
                                <Viewbox Width="14" Height="14"><Path Classes="stroke" Data="{StaticResource IconArrowUp}" /></Viewbox>
                            </Button>
                            <Button Classes="icon" Padding="4" ToolTip.Tip="Move down" AutomationProperties.Name="Move down" IsVisible="{Binding InRotation}" IsEnabled="{Binding CanMoveDown}" Command="{Binding MoveDownCommand}">
                                <Viewbox Width="14" Height="14"><Path Classes="stroke" Data="M12 19V5M18 13L12 19M6 13L12 19" /></Viewbox>
                            </Button>
                            <Button Padding="8,3" Content="Add to rotation" IsVisible="{Binding CanJoin}" IsEnabled="{Binding Idle}" Command="{Binding JoinCommand}" />
                            <Button Classes="icon" Padding="4" ToolTip.Tip="More actions" AutomationProperties.Name="More actions" IsEnabled="{Binding Idle}">
                                <Viewbox Width="14" Height="14"><Path Classes="stroke" Data="{StaticResource IconDots}" /></Viewbox>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Replace token" Command="{Binding AskReplaceCommand}" />
                                        <MenuItem Header="Leave rotation" IsVisible="{Binding CanLeave}" Command="{Binding LeaveCommand}" />
                                        <MenuItem Header="Remove" Command="{Binding AskRemoveCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <WrapPanel>
                                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,2" />
                                <Border Classes="badge" Margin="0,0,6,2" IsVisible="{Binding Next}"><TextBlock Classes="quiet good" Text="Next" /></Border>
                                <Border Classes="badge" Margin="0,0,6,2" IsVisible="{Binding Limit, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Classes="quiet caution" Text="{Binding Limit}" /></Border>
                                <Border Classes="badge" Margin="0,0,6,2" IsVisible="{Binding Hosts, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Classes="quiet" Text="{Binding Hosts}" /></Border>
                            </WrapPanel>
                            <TextBlock Classes="quiet" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding Replacing}">
                        <TextBlock Classes="quiet" Text="{Binding Name, StringFormat='New token for {0}'}" />
                        <TextBox Text="{Binding Replacement}" PasswordChar="•" IsEnabled="{Binding Idle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="primary" Content="Save" Command="{Binding SaveReplacementCommand}" IsEnabled="{Binding CanSaveReplacement}" />
                            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelReplaceCommand}" IsEnabled="{Binding Idle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding ConfirmingRemove}">
                        <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding RemovalWarning}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="danger confirming" Content="Remove account" Command="{Binding RemoveCommand}" IsEnabled="{Binding Idle}" />
                            <Button Classes="ghost" Content="Keep it" Command="{Binding CancelRemoveCommand}" IsEnabled="{Binding Idle}" />
                        </StackPanel>
                    </StackPanel>
                    <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:AccountsControl">
            <StackPanel Spacing="10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="8,3" Content="Add account" Command="{Binding AskAddCommand}" IsVisible="{Binding !Adding}" />
                    <TextBlock Classes="heading" Text="Accounts" VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="{DynamicResource Panel}" CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="1">
                        <TextBlock FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Text="{Binding Headline}" />
                        <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Detail}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Panel}" CornerRadius="6" Padding="10,8" IsVisible="{Binding Adding}">
                    <StackPanel Spacing="6">
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}" Width="180" Margin="0,0,6,6" IsEnabled="{Binding Idle}" AutomationProperties.Name="Type" />
                            <TextBox Text="{Binding NewName}" PlaceholderText="claude-2" Width="160" Margin="0,0,0,6" IsEnabled="{Binding Idle}" AutomationProperties.Name="Name" />
                        </WrapPanel>
                        <TextBlock Classes="quiet caution" TextWrapping="Wrap" IsVisible="{Binding NameTaken}" Text="That name is taken. Use Replace token on that account." />
                        <CheckBox Content="Add to rotation" IsChecked="{Binding JoinRotation}" IsEnabled="{Binding Idle}" />
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsSignIn}">
                            <TextBlock Classes="quiet" TextWrapping="Wrap" IsVisible="{Binding !SigningIn}" Text="Opens your browser to authorize. The token belongs to the account signed in there, so check it's the right one before you approve." />
                            <Button Classes="primary" Content="Sign in with Claude" HorizontalAlignment="Left" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" IsVisible="{Binding !SigningIn}" />
                            <StackPanel Spacing="4" IsVisible="{Binding SigningIn}">
                                <TextBlock FontSize="13" TextWrapping="Wrap" Text="Waiting for you to authorize in your browser." />
                                <StackPanel Spacing="2" IsVisible="{Binding SignInLink, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Wrong account, or no browser? Open this link in a private window:" />
                                    <SelectableTextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding SignInLink}" />
                                </StackPanel>
                                <Button Content="Stop" HorizontalAlignment="Left" Command="{Binding StopSignInCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding PasteHint}" IsVisible="{Binding !SigningIn}" />
                        <StackPanel Spacing="6" IsVisible="{Binding !SigningIn}">
                            <TextBox Text="{Binding NewToken}" PlaceholderText="Token" PasswordChar="•" Width="346" HorizontalAlignment="Left" IsEnabled="{Binding Idle}" AutomationProperties.Name="Token" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes.primary="{Binding !ShowsSignIn}" Content="Save account" Command="{Binding SaveNewCommand}" IsEnabled="{Binding CanSaveNew}" />
                                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelAddCommand}" IsEnabled="{Binding Idle}" />
                            </StackPanel>
                        </StackPanel>
                        <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding AddError}" IsVisible="{Binding AddError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="4" IsVisible="{Binding HasRotation}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Rotation" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Used by any engine with no account of its own, top first." />
                    <ItemsControl ItemsSource="{Binding Rotation}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasCodexRotation}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Codex rotation" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Used by Codex engines, top first." />
                    <ItemsControl ItemsSource="{Binding CodexRotation}" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasOutside}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Not in rotation" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Only a host assigned one of these uses it. Assign them on the Hosts page." />
                    <ItemsControl ItemsSource="{Binding Outside}" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:MachineSignInControl">
            <StackPanel Spacing="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" IsVisible="{Binding Viewing}">
                        <Button Padding="8,3" Content="{Binding EditAction}" Command="{Binding AskEditCommand}" />
                        <Button Classes="ghost" Padding="8,3" Content="Remove" Command="{Binding AskRemoveCommand}" IsVisible="{Binding CanRemove}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding Source}" />
                        <Border Classes="badge" HorizontalAlignment="Left" IsVisible="{Binding Limit, Converter={x:Static ObjectConverters.IsNotNull}}"><TextBlock Classes="quiet caution" Text="{Binding Limit}" /></Border>
                        <TextBlock Classes="quiet" TextWrapping="Wrap" IsVisible="{Binding Unused}" Text="Not used while rotation has accounts: engines take the first one free." />
                    </StackPanel>
                </DockPanel>
                <StackPanel Spacing="4" IsVisible="{Binding Editing}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Engine token" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="What engines on this machine sign in with, ahead of the config directory below. Make one with claude setup-token. A change applies to stages and planning sessions started afterwards, never one already running." />
                    <TextBox Text="{Binding Draft}" PasswordChar="•" IsEnabled="{Binding Idle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEditCommand}" IsEnabled="{Binding Idle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding ConfirmingRemove}">
                    <TextBlock FontSize="13" TextWrapping="Wrap" Text="Remove this machine's saved token? Engines here go back to the login in their Claude config directory." />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="danger confirming" Content="Remove token" Command="{Binding RemoveCommand}" IsEnabled="{Binding Idle}" />
                        <Button Classes="ghost" Content="Keep it" Command="{Binding CancelRemoveCommand}" IsEnabled="{Binding Idle}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Classes="quiet caution" TextWrapping="Wrap" Text="{Binding OtherLimits}" IsVisible="{Binding OtherLimits, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ChatEngineControl">
            <StackPanel Spacing="6">
                <StackPanel Spacing="6" IsVisible="{Binding Loaded}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton GroupName="engine" Content="Claude Agent SDK" IsChecked="{Binding UsesCli}" IsEnabled="{Binding Idle}" />
                        <RadioButton GroupName="engine" Content="AI SDK" IsChecked="{Binding UsesApi}" IsEnabled="{Binding Idle}" />
                    </StackPanel>
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Hint}" />
                    <StackPanel Spacing="2" IsVisible="{Binding UsesApi}">
                        <TextBlock FontSize="13" FontWeight="Medium" Text="Provider" />
                        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="180" IsEnabled="{Binding Idle}" />
                    </StackPanel>
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Model" />
                    <TextBox Text="{Binding Model}" IsEnabled="{Binding Idle}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" HorizontalAlignment="Left" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SecurityControl">
            <StackPanel Spacing="8">
                <TextBlock Classes="quiet" TextWrapping="Wrap" Text="A second factor makes signing in need your phone or a passkey as well as your password. This app and the CLI can use an authenticator app but not a passkey, so set one up too if you use either." />
                <ItemsControl ItemsSource="{Binding Factors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FactorRow">
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Classes="danger" Padding="8,3" Content="Remove" Command="{Binding Control.RemoveCommand}" CommandParameter="{Binding}" IsEnabled="{Binding Control.Idle}" />
                                <TextBlock FontSize="13" Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="8" IsVisible="{Binding Enrolling}">
                    <TextBlock FontSize="13" Text="Scan this with your authenticator app, then enter the code it shows." />
                    <Border Background="White" Padding="6" HorizontalAlignment="Left" CornerRadius="4">
                        <Image Source="{Binding QrCode}" Width="180" Height="180" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="quiet" Text="Can't scan it? Enter this key:" VerticalAlignment="Center" />
                        <SelectableTextBlock Classes="mono" Text="{Binding Secret}" />
                    </StackPanel>
                    <TextBox Text="{Binding Code}" PlaceholderText="Code" Width="180" HorizontalAlignment="Left" IsEnabled="{Binding Idle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Turn on" Command="{Binding VerifyCommand}" IsEnabled="{Binding Idle}" />
                        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEnrollingCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding NotEnrolling}">
                    <Button Content="Set up an authenticator app" Command="{Binding StartCommand}" IsEnabled="{Binding CanSetUp}" IsVisible="{Binding !HasAuthenticator}" />
                    <Button Classes="ghost" Content="Add a passkey in the web app" Command="{Binding AddPasskeyCommand}" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="720" HorizontalAlignment="Left" MinWidth="560">
            <TextBlock Classes="title" Text="Settings" />
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Auto-mode" />
                    <ContentControl Content="{Binding AutoMode}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Drain" />
                    <ContentControl Content="{Binding Drain}" />
                    <TextBlock FontSize="13" Classes.good="{Binding Shell.Drain.SafeToRestart, FallbackValue=False}" TextWrapping="Wrap" Text="{Binding Shell.DrainLine}" IsVisible="{Binding Shell.DrainLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Auto-split" />
                    <ContentControl Content="{Binding AutoSplit}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Poll interval" />
                    <ContentControl Content="{Binding PollInterval}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Stage concurrency" />
                    <ContentControl Content="{Binding Concurrency}" />
                    <ContentControl Content="{Binding LocalSlots}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="6">
                    <TextBlock Classes="heading" Text="Notifications" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="These carry different risk. The webhook URL is a destination this daemon sends a request to, so the server checks it (https only, and not an address that resolves somewhere private) both when it is saved and again every time it is used, and refuses anything that fails. The base URL only appears as a link inside that request's payload. Nothing here ever fetches it, so it is saved exactly as typed." />
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Webhook URL" Margin="0,4,0,0" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Where notifications are sent. Checked by the server on save and on every use. A refused value is never stored." />
                    <TextBox Text="{Binding WebhookDraft}" PlaceholderText="https://example.com/hook" IsEnabled="{Binding WebhookIdle}" />
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Base URL" Margin="0,4,0,0" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="A link back to this board, included in the notification payload. Not validated: it is never a destination this daemon contacts." />
                    <TextBox Text="{Binding BaseUrlDraft}" PlaceholderText="https://board.example" IsEnabled="{Binding WebhookIdle}" />
                    <Button Content="Save" Command="{Binding SaveWebhookCommand}" IsEnabled="{Binding WebhookDirty}" HorizontalAlignment="Left" />
                    <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding WebhookError}" IsVisible="{Binding WebhookError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <SelectableTextBlock Classes="quiet" Text="{Binding WebhookStillSaved}" IsVisible="{Binding WebhookStillSaved, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <ContentControl Content="{Binding Accounts}" />
                    <TextBlock FontSize="13" FontWeight="Medium" Text="This server's own sign-in" />
                    <ContentControl Content="{Binding MachineSignIn}" />
                    <ContentControl Content="{Binding ClaudeConfigDir}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="GitHub" />
                    <ContentControl Content="{Binding GitHubApp}" />
                    <TextBlock Classes="quiet" Classes.caution="{Binding GitHubKeyMissing}" TextWrapping="Wrap" Text="{Binding GitHubKey}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Stage routing" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="For this server's default project. Every project's own routing is on its Lanes page." />
                    <ContentControl Content="{Binding StageRouting}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Chat" />
                    <ContentControl Content="{Binding ChatEngine}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Security" />
                    <ContentControl Content="{Binding Security}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="6">
                    <TextBlock Classes="heading" Text="Deployment" />
                    <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding DeploymentError}" IsVisible="{Binding DeploymentError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeploymentFact">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock DockPanel.Dock="Left" Classes="quiet" Width="100" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <SelectableTextBlock Classes="mono" Classes.quiet="{Binding Topology}" Text="{Binding Value}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Code and worktree roots are environment-only: set at deploy time, not editable here. Changing them out from under a running daemon is a redeploy, not a setting." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
