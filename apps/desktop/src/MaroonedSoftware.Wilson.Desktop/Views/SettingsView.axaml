<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MaroonedSoftware.Wilson.Desktop.ViewModels"
    x:Class="MaroonedSoftware.Wilson.Desktop.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SwitchSetting">
            <StackPanel Spacing="4">
                <DockPanel IsVisible="{Binding Loaded}">
                    <ToggleSwitch DockPanel.Dock="Left" IsChecked="{Binding On}" IsEnabled="{Binding Idle}" OnContent="" OffContent="" VerticalAlignment="Top" AutomationProperties.Name="{Binding Label}" />
                    <StackPanel Spacing="1" Margin="4,0,0,0">
                        <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" />
                        <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Description}" />
                    </StackPanel>
                </DockPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberSetting">
            <StackPanel Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding Loaded}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Description}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Value="{Binding Draft}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Step}" FormatString="0" Width="180" IsEnabled="{Binding Idle}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" />
                    </StackPanel>
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TextSetting">
            <StackPanel Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding Loaded}">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Label}" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Description}" />
                    <TextBox Text="{Binding Draft}" PlaceholderText="{Binding Placeholder}" IsEnabled="{Binding Idle}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" HorizontalAlignment="Left" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <SelectableTextBlock Classes="quiet" Text="{Binding StillSaved}" IsVisible="{Binding StillSaved, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:EngineTokenControl">
            <StackPanel Spacing="4">
                <TextBlock FontSize="13" FontWeight="Medium" Text="Engine token" />
                <TextBlock Classes="quiet" TextWrapping="Wrap" Text="What engines on this machine sign in with, ahead of the config directory above. Make one with claude setup-token. Worker hosts use the tokens below, and SSH hosts their own. A change applies to stages and planning sessions started afterwards, never one already running." />
                <TextBox Text="{Binding Draft}" PasswordChar="•" IsEnabled="{Binding Idle}" />
                <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding Source}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                    <Button Classes="ghost" Content="Remove" Command="{Binding RemoveCommand}" IsEnabled="{Binding Idle}" IsVisible="{Binding CanRemove}" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:WorkerTokensControl">
            <StackPanel Spacing="4">
                <TextBlock FontSize="13" FontWeight="Medium" Text="Worker engine tokens" />
                <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Tokens Wilson holds for worker hosts, each assigned on the Hosts page. Wilson sends one to its worker with each engine start, and a stage there can read it. Saving under an existing name replaces that token. Removing one sends its hosts back to their own sign-in, leaves running engines alone, and does not revoke it with Anthropic." />
                <ItemsControl ItemsSource="{Binding Tokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EngineTokenRow">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,3">
                                <TextBlock FontSize="13" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Classes="quiet" Text="{Binding Hosts}" VerticalAlignment="Center" />
                                <Button Classes="ghost" Padding="8,3" Content="Remove" Command="{Binding Control.RemoveCommand}" CommandParameter="{Binding}" IsEnabled="{Binding Control.Idle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding Name}" PlaceholderText="Name" Width="180" IsEnabled="{Binding Idle}" />
                    <TextBox Text="{Binding Token}" PlaceholderText="Token" PasswordChar="•" Width="260" IsEnabled="{Binding Idle}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ChatEngineControl">
            <StackPanel Spacing="6">
                <StackPanel Spacing="6" IsVisible="{Binding Loaded}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton GroupName="engine" Content="Claude Agent SDK" IsChecked="{Binding UsesCli}" IsEnabled="{Binding Idle}" />
                        <RadioButton GroupName="engine" Content="AI SDK" IsChecked="{Binding UsesApi}" IsEnabled="{Binding Idle}" />
                    </StackPanel>
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="{Binding Hint}" />
                    <StackPanel Spacing="2" IsVisible="{Binding UsesApi}">
                        <TextBlock FontSize="13" FontWeight="Medium" Text="Provider" />
                        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="180" IsEnabled="{Binding Idle}" />
                    </StackPanel>
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Model" />
                    <TextBox Text="{Binding Model}" IsEnabled="{Binding Idle}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" HorizontalAlignment="Left" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SecurityControl">
            <StackPanel Spacing="8">
                <TextBlock Classes="quiet" TextWrapping="Wrap" Text="A second factor makes signing in need your phone or a passkey as well as your password. This app and the CLI can use an authenticator app but not a passkey, so set one up too if you use either." />
                <ItemsControl ItemsSource="{Binding Factors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FactorRow">
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Classes="danger" Padding="8,3" Content="Remove" Command="{Binding Control.RemoveCommand}" CommandParameter="{Binding}" IsEnabled="{Binding Control.Idle}" />
                                <TextBlock FontSize="13" Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="8" IsVisible="{Binding Enrolling}">
                    <TextBlock FontSize="13" Text="Scan this with your authenticator app, then enter the code it shows." />
                    <Border Background="White" Padding="6" HorizontalAlignment="Left" CornerRadius="4">
                        <Image Source="{Binding QrCode}" Width="180" Height="180" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="quiet" Text="Can't scan it? Enter this key:" VerticalAlignment="Center" />
                        <SelectableTextBlock Classes="mono" Text="{Binding Secret}" />
                    </StackPanel>
                    <TextBox Text="{Binding Code}" PlaceholderText="Code" Width="180" HorizontalAlignment="Left" IsEnabled="{Binding Idle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Turn on" Command="{Binding VerifyCommand}" IsEnabled="{Binding Idle}" />
                        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEnrollingCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding NotEnrolling}">
                    <Button Content="Set up an authenticator app" Command="{Binding StartCommand}" IsEnabled="{Binding CanSetUp}" IsVisible="{Binding !HasAuthenticator}" />
                    <Button Classes="ghost" Content="Add a passkey in the web app" Command="{Binding AddPasskeyCommand}" />
                </StackPanel>
                <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="720" HorizontalAlignment="Left" MinWidth="560">
            <TextBlock Classes="title" Text="Settings" />
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Auto-mode" />
                    <ContentControl Content="{Binding AutoMode}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Drain" />
                    <ContentControl Content="{Binding Drain}" />
                    <TextBlock FontSize="13" Classes.good="{Binding Shell.Drain.SafeToRestart, FallbackValue=False}" TextWrapping="Wrap" Text="{Binding Shell.DrainLine}" IsVisible="{Binding Shell.DrainLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Auto-split" />
                    <ContentControl Content="{Binding AutoSplit}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Poll interval" />
                    <ContentControl Content="{Binding PollInterval}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Stage concurrency" />
                    <ContentControl Content="{Binding Concurrency}" />
                    <ContentControl Content="{Binding LocalSlots}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="6">
                    <TextBlock Classes="heading" Text="Notifications" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="These carry different risk. The webhook URL is a destination this daemon sends a request to, so the server checks it (https only, and not an address that resolves somewhere private) both when it is saved and again every time it is used, and refuses anything that fails. The base URL only appears as a link inside that request's payload. Nothing here ever fetches it, so it is saved exactly as typed." />
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Webhook URL" Margin="0,4,0,0" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Where notifications are sent. Checked by the server on save and on every use. A refused value is never stored." />
                    <TextBox Text="{Binding WebhookDraft}" PlaceholderText="https://example.com/hook" IsEnabled="{Binding WebhookIdle}" />
                    <TextBlock FontSize="13" FontWeight="Medium" Text="Base URL" Margin="0,4,0,0" />
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="A link back to this board, included in the notification payload. Not validated: it is never a destination this daemon contacts." />
                    <TextBox Text="{Binding BaseUrlDraft}" PlaceholderText="https://board.example" IsEnabled="{Binding WebhookIdle}" />
                    <Button Content="Save" Command="{Binding SaveWebhookCommand}" IsEnabled="{Binding WebhookDirty}" HorizontalAlignment="Left" />
                    <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding WebhookError}" IsVisible="{Binding WebhookError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <SelectableTextBlock Classes="quiet" Text="{Binding WebhookStillSaved}" IsVisible="{Binding WebhookStillSaved, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Classes="heading" Text="Engine credentials" />
                    <ContentControl Content="{Binding ClaudeConfigDir}" />
                    <ContentControl Content="{Binding EngineToken}" />
                    <ContentControl Content="{Binding WorkerTokens}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="GitHub" />
                    <ContentControl Content="{Binding GitHubApp}" />
                    <TextBlock Classes="quiet" Classes.caution="{Binding GitHubKeyMissing}" TextWrapping="Wrap" Text="{Binding GitHubKey}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Chat" />
                    <ContentControl Content="{Binding ChatEngine}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Security" />
                    <ContentControl Content="{Binding Security}" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="6">
                    <TextBlock Classes="heading" Text="Deployment" />
                    <SelectableTextBlock Classes="error" FontSize="13" Text="{Binding DeploymentError}" IsVisible="{Binding DeploymentError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeploymentFact">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock DockPanel.Dock="Left" Classes="quiet" Width="100" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <SelectableTextBlock Classes="mono" Classes.quiet="{Binding Topology}" Text="{Binding Value}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="quiet" TextWrapping="Wrap" Text="Code and worktree roots are environment-only: set at deploy time, not editable here. Changing them out from under a running daemon is a redeploy, not a setting." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
