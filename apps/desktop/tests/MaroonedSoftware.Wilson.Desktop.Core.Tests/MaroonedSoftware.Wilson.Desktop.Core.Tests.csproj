<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>MaroonedSoftware.Wilson.Desktop.Core.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/MaroonedSoftware.Wilson.Desktop.Core/MaroonedSoftware.Wilson.Desktop.Core.csproj" />
    </ItemGroup>

    <!-- Real API responses, recorded for the Android tests. One set, so the two clients cannot disagree. -->
    <ItemGroup>
        <None Include="../../../android/app/src/test/resources/api/*.json" LinkBase="api" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- What the web app's operator-app host and this one must agree on. It reads the same file. -->
    <ItemGroup>
        <None Include="../../../web/tests/fixtures/app-host.json" Link="fixtures/app-host.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
